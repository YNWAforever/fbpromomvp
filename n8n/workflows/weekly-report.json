                  {
                      "parameters":  {
                                         "jsCode":  "const crypto = require(\"crypto\");\nconst scheduledAt = new Date().toISOString();\nconst timestamp = String(Date.now());\nconst hongKongParts = new Intl.DateTimeFormat(\"en-CA\", { timeZone: \"Asia/Hong_Kong\", year: \"numeric\", month: \"2-digit\", day: \"2-digit\" }).formatToParts(new Date());\nconst value = (type) =\u003e hongKongParts.find((part) =\u003e part.type === type).value;\nconst hongKongMidnight = new Date(Date.UTC(Number(value(\"year\")), Number(value(\"month\")) - 1, Number(value(\"day\"))));\nconst daysSinceMonday = (hongKongMidnight.getUTCDay() + 6) % 7;\nconst periodEndDate = new Date(hongKongMidnight);\nperiodEndDate.setUTCDate(hongKongMidnight.getUTCDate() - daysSinceMonday);\nconst periodStartDate = new Date(periodEndDate);\nperiodStartDate.setUTCDate(periodEndDate.getUTCDate() - 7);\nconst periodStart = periodStartDate.toISOString();\nconst periodEnd = periodEndDate.toISOString();\nconst payload = { runId: `weekly:${$execution.id}`, periodStart, periodEnd };\nconst body = JSON.stringify(payload);\nconst signature = crypto.createHmac(\"sha256\", $env.N8N_HMAC_SECRET).update(`${timestamp}.${body}`).digest(\"hex\");\nreturn [{ json: { body, timestamp, signature, idempotencyKey: payload.runId, attempt: 1 } }];"
                                     },
