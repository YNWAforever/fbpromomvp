                  {
                      "parameters":  {
                                         "jsCode":  "const crypto = require(\"crypto\");\nconst scheduledAt = new Date().toISOString();\nconst timestamp = String(Date.now());\nconst payload = { runId: `hourly:${$execution.id}`, scheduledAt };\nconst body = JSON.stringify(payload);\nconst signature = crypto.createHmac(\"sha256\", $env.N8N_HMAC_SECRET).update(`${timestamp}.${body}`).digest(\"hex\");\nreturn [{ json: { body, timestamp, signature, idempotencyKey: payload.runId, attempt: 1 } }];"
                                     },
